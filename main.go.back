/**
 * Claude-to-OpenAI API Proxy for Go
 *
 * This HTTP server acts as a proxy, converting API requests from the Claude format to the OpenAI format,
 * and then converting the responses back. It enables using OpenAI-compatible APIs (like OpenAI,
 * Azure OpenAI, Google Gemini, Ollama, etc.) with clients designed for the Claude API.
 *
 * Features:
 * - Full support for the /v1/messages endpoint.
 * - Correctly handles and translates tool calls (function calling), including cleaning schemas
 * for compatibility with strict APIs like Google Gemini.
 * - Supports streaming responses (Server-Sent Events).
 * - Designed for easy deployment.
 */

package main

import (
	"bufio"
	"bytes"
	"encoding/json"
	"fmt"
	"io"
	"log"
	"net/http"
	"os"
	"regexp"
	"strings"

	"github.com/joho/godotenv"
)

// --- TYPE DEFINITIONS ---

// Env represents environment variables
type Env struct {
	OpenAIBaseURL string
	OpenAPIKey    string
	Port          string
}

// --- Claude API Types ---

type ClaudeTool struct {
	Name        string                 `json:"name"`
	Description string                 `json:"description,omitempty"`
	InputSchema map[string]interface{} `json:"input_schema"`
}

type ClaudeContentBlock struct {
	Type       string                 `json:"type"`
	Text       *string                `json:"text,omitempty"`
	Thinking   *string                `json:"thinking,omitempty"`
	Signature  *string                `json:"signature,omitempty"`
	Source     *ClaudeSource          `json:"source,omitempty"`
	ID         *string                `json:"id,omitempty"`
	Name       *string                `json:"name,omitempty"`
	Input      map[string]interface{} `json:"input,omitempty"`
	ToolUseID  *string                `json:"tool_use_id,omitempty"`
	Content    interface{}            `json:"content,omitempty"`
}

type ClaudeSource struct {
	Type      string `json:"type"`
	MediaType string `json:"media_type"`
	Data      string `json:"data"`
}

type ClaudeMessage struct {
	Role    string      `json:"role"`
	Content interface{} `json:"content"` // string or []ClaudeContentBlock
}

type ClaudeThinking struct {
	Type         string `json:"type"`
	BudgetTokens *int   `json:"budget_tokens,omitempty"`
}

type ClaudeToolChoice struct {
	Type string  `json:"type"`
	Name *string `json:"name,omitempty"`
}

type ClaudeMessagesRequest struct {
	Model         string            `json:"model"`
	Messages      []ClaudeMessage   `json:"messages"`
	System        *string           `json:"system,omitempty"`
	MaxTokens     int               `json:"max_tokens"`
	StopSequences []string          `json:"stop_sequences,omitempty"`
	Stream        *bool             `json:"stream,omitempty"`
	Temperature   *float64          `json:"temperature,omitempty"`
	TopP          *float64          `json:"top_p,omitempty"`
	TopK          *int              `json:"top_k,omitempty"`
	Tools         []ClaudeTool      `json:"tools,omitempty"`
	ToolChoice    *ClaudeToolChoice `json:"tool_choice,omitempty"`
	Thinking      *ClaudeThinking   `json:"thinking,omitempty"`
}

// --- OpenAI API Types ---

type OpenAIContentBlock struct {
	Type      string  `json:"type"`
	Text      *string `json:"text,omitempty"`
	Thinking  *string `json:"thinking,omitempty"`
	Signature *string `json:"signature,omitempty"`
	ImageURL  *struct {
		URL string `json:"url"`
	} `json:"image_url,omitempty"`
}

type OpenAIMessage struct {
	Role            string                `json:"role"`
	Content         interface{}           `json:"content"` // string or []OpenAIContentBlock
	ToolCalls       []OpenAIToolCall      `json:"tool_calls,omitempty"`
	ToolCallID      *string               `json:"tool_call_id,omitempty"`
	ReasoningContent *string              `json:"reasoning_content,omitempty"`
	ThinkingBlocks  []OpenAIThinkingBlock `json:"thinking_blocks,omitempty"`
}

type OpenAIThinkingBlock struct {
	Type      string  `json:"type"`
	Thinking  string  `json:"thinking"`
	Signature *string `json:"signature,omitempty"`
}

type OpenAIToolCall struct {
	ID       string `json:"id"`
	Type     string `json:"type"`
	Function struct {
		Name      string `json:"name"`
		Arguments string `json:"arguments"`
	} `json:"function"`
}

type OpenAITool struct {
	Type     string `json:"type"`
	Function struct {
		Name        string                 `json:"name"`
		Description string                 `json:"description,omitempty"`
		Parameters  map[string]interface{} `json:"parameters"`
	} `json:"function"`
}

type OpenAIToolChoice struct {
	Type     string `json:"type"`
	Function struct {
		Name string `json:"name"`
	} `json:"function"`
}

type OpenAIRequest struct {
	Model         string           `json:"model"`
	Messages      []OpenAIMessage  `json:"messages"`
	MaxTokens     *int             `json:"max_tokens,omitempty"`
	Temperature   *float64         `json:"temperature,omitempty"`
	TopP          *float64         `json:"top_p,omitempty"`
	Stop          []string         `json:"stop,omitempty"`
	Stream        *bool            `json:"stream,omitempty"`
	Tools         []OpenAITool     `json:"tools,omitempty"`
	ToolChoice    interface{}      `json:"tool_choice,omitempty"`
	StreamOptions *StreamOptions   `json:"stream_options,omitempty"`
	Thinking      *ClaudeThinking  `json:"thinking,omitempty"`
}

type StreamOptions struct {
	IncludeUsage bool `json:"include_usage"`
}

// --- Global Variables ---

var env Env

func init() {
	// Load .env file
	godotenv.Load()

	env = Env{
		OpenAIBaseURL: getEnv("OPENAI_BASE_URL", "http://localhost:8094/v1"),
		Port:          getEnv("PORT", "8092"),
		OpenAPIKey:    getEnv("OPENAI_API_KEY", ""),
	}
}

func getEnv(key, defaultValue string) string {
	value := os.Getenv(key)
	if value == "" {
		return defaultValue
	}
	return value
}

// --- Main Function ---

func main() {
	http.HandleFunc("/v1/messages", handleMessages)
	http.HandleFunc("/health", handleHealth)

	log.Printf("Claude Proxy server is running on port %s", env.Port)
	log.Printf("Health check: http://localhost:%s/health", env.Port)
	log.Printf("API endpoint: http://localhost:%s/v1/messages", env.Port)

	if err := http.ListenAndServe(":"+env.Port, nil); err != nil {
		log.Fatal(err)
	}
}

// --- Route Handlers ---

func handleHealth(w http.ResponseWriter, r *http.Request) {
	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(map[string]string{
		"status":    "ok",
		"timestamp": fmt.Sprintf("%v", os.Getenv("timestamp")),
	})
}

func handleMessages(w http.ResponseWriter, r *http.Request) {
	// Enable CORS
	w.Header().Set("Access-Control-Allow-Origin", "*")
	w.Header().Set("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
	w.Header().Set("Access-Control-Allow-Headers", "Content-Type, Authorization, x-api-key, Anthropic-Version")

	if r.Method == "OPTIONS" {
		w.WriteHeader(http.StatusOK)
		return
	}

	if r.Method != "POST" {
		w.WriteHeader(http.StatusMethodNotAllowed)
		json.NewEncoder(w).Encode(map[string]string{"error": "Method Not Allowed"})
		return
	}

	// Extract API key
	authHeader := r.Header.Get("Authorization")
	var apiKey string
	if authHeader != "" {
		re := regexp.MustCompile(`^Bearer\s+(.+)$`)
		matches := re.FindStringSubmatch(authHeader)
		if len(matches) > 1 {
			apiKey = matches[1]
		}
	}
	if apiKey == "" {
		apiKey = r.Header.Get("x-api-key")
	}
	if apiKey == "" {
		w.WriteHeader(http.StatusUnauthorized)
		json.NewEncoder(w).Encode(map[string]string{"error": "Missing API key. Provide Authorization: Bearer <key> or x-api-key header."})
		return
	}

	// Parse request body
	var claudeRequest ClaudeMessagesRequest
	if err := json.NewDecoder(r.Body).Decode(&claudeRequest); err != nil {
		w.WriteHeader(http.StatusBadRequest)
		json.NewEncoder(w).Encode(map[string]string{"error": err.Error()})
		return
	}

	// Convert Claude request to OpenAI format
	openaiRequest := convertClaudeToOpenAIRequest(&claudeRequest)

	// Make request to OpenAI API
	openaiResp, err := makeOpenAIRequest(&openaiRequest, apiKey)
	if err != nil {
		w.WriteHeader(http.StatusInternalServerError)
		json.NewEncoder(w).Encode(map[string]string{"error": err.Error()})
		return
	}
	defer openaiResp.Body.Close()

	// Forward http_x_reqid header
	if reqID := openaiResp.Header.Get("http_x_reqid"); reqID != "" {
		w.Header().Set("http_x_reqid", reqID)
	}

	if openaiResp.StatusCode != http.StatusOK {
		w.WriteHeader(openaiResp.StatusCode)
		io.Copy(w, openaiResp.Body)
		return
	}

	// Handle streaming vs non-streaming
	if claudeRequest.Stream != nil && *claudeRequest.Stream {
		handleStreamingResponse(w, openaiResp, claudeRequest.Model)
	} else {
		handleNonStreamingResponse(w, openaiResp, claudeRequest.Model)
	}
}

func makeOpenAIRequest(openaiRequest *OpenAIRequest, apiKey string) (*http.Response, error) {
	body, err := json.Marshal(openaiRequest)
	if err != nil {
		return nil, err
	}

	req, err := http.NewRequest("POST", env.OpenAIBaseURL+"/chat/completions", bytes.NewBuffer(body))
	if err != nil {
		return nil, err
	}

	req.Header.Set("Content-Type", "application/json")
	req.Header.Set("Authorization", "Bearer "+apiKey)

	client := &http.Client{}
	return client.Do(req)
}

func handleNonStreamingResponse(w http.ResponseWriter, openaiResp *http.Response, model string) {
	var openaiResponse map[string]interface{}
	if err := json.NewDecoder(openaiResp.Body).Decode(&openaiResponse); err != nil {
		w.WriteHeader(http.StatusInternalServerError)
		json.NewEncoder(w).Encode(map[string]string{"error": err.Error()})
		return
	}

	claudeResponse := convertOpenAIToClaudeResponse(openaiResponse, model)
	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(claudeResponse)
}

func handleStreamingResponse(w http.ResponseWriter, openaiResp *http.Response, model string) {
	w.Header().Set("Content-Type", "text/event-stream")
	w.Header().Set("Cache-Control", "no-cache")
	w.Header().Set("Connection", "keep-alive")

	flusher, ok := w.(http.Flusher)
	if !ok {
		http.Error(w, "Streaming not supported", http.StatusInternalServerError)
		return
	}

	transformer := newStreamTransformer(model)
	scanner := bufio.NewScanner(openaiResp.Body)

	for scanner.Scan() {
		line := scanner.Text()
		events := transformer.transform(line)
		for _, event := range events {
			fmt.Fprintf(w, "%s", event)
			flusher.Flush()
		}
	}

	if err := scanner.Err(); err != nil {
		log.Printf("Error reading stream: %v", err)
	}
}

// --- Helper Functions ---

func recursivelyCleanSchema(schema interface{}) interface{} {
	if schema == nil {
		return schema
	}

	switch v := schema.(type) {
	case map[string]interface{}:
		newSchema := make(map[string]interface{})
		for key, val := range v {
			if key == "$schema" || key == "additionalProperties" {
				continue
			}
			newSchema[key] = recursivelyCleanSchema(val)
		}

		// Remove unsupported format fields for string types
		if typ, ok := newSchema["type"].(string); ok && typ == "string" {
			if format, ok := newSchema["format"].(string); ok {
				supportedFormats := []string{"date-time", "enum"}
				isSupported := false
				for _, sf := range supportedFormats {
					if format == sf {
						isSupported = true
						break
					}
				}
				if !isSupported {
					delete(newSchema, "format")
				}
			}
		}
		return newSchema

	case []interface{}:
		newArray := make([]interface{}, len(v))
		for i, item := range v {
			newArray[i] = recursivelyCleanSchema(item)
		}
		return newArray

	default:
		return schema
	}
}

func convertClaudeToOpenAIRequest(claudeRequest *ClaudeMessagesRequest) OpenAIRequest {
	var openaiMessages []OpenAIMessage

	// Add system message if present
	if claudeRequest.System != nil {
		openaiMessages = append(openaiMessages, OpenAIMessage{
			Role:    "system",
			Content: *claudeRequest.System,
		})
	}

	// Convert messages
	for _, message := range claudeRequest.Messages {
		if message.Role == "user" {
			// Handle user messages
			if contentBlocks, ok := message.Content.([]interface{}); ok {
				var toolResults []ClaudeContentBlock
				var otherContent []OpenAIContentBlock

				// Parse content blocks
				for _, block := range contentBlocks {
					blockMap, _ := block.(map[string]interface{})
					var cb ClaudeContentBlock
					b, _ := json.Marshal(blockMap)
					json.Unmarshal(b, &cb)

					if cb.Type == "tool_result" {
						toolResults = append(toolResults, cb)
					} else {
						if cb.Type == "text" {
							otherContent = append(otherContent, OpenAIContentBlock{
								Type: "text",
								Text: cb.Text,
							})
						} else if cb.Type == "image" && cb.Source != nil {
							url := fmt.Sprintf("data:%s;base64,%s", cb.Source.MediaType, cb.Source.Data)
							otherContent = append(otherContent, OpenAIContentBlock{
								Type: "image_url",
								ImageURL: &struct {
									URL string `json:"url"`
								}{URL: url},
							})
						}
					}
				}

				// Add tool result messages
				for _, tr := range toolResults {
					content := ""
					if str, ok := tr.Content.(string); ok {
						content = str
					} else {
						b, _ := json.Marshal(tr.Content)
						content = string(b)
					}
					openaiMessages = append(openaiMessages, OpenAIMessage{
						Role:       "tool",
						ToolCallID: tr.ToolUseID,
						Content:    content,
					})
				}

				// Add user message with other content
				if len(otherContent) > 0 {
					openaiMessages = append(openaiMessages, OpenAIMessage{
						Role:    "user",
						Content: otherContent,
					})
				}
			} else {
				// Simple string content
				openaiMessages = append(openaiMessages, OpenAIMessage{
					Role:    "user",
					Content: message.Content,
				})
			}
		} else if message.Role == "assistant" {
			// Handle assistant messages
			var contentBlocks []OpenAIContentBlock
			var toolCalls []OpenAIToolCall

			if blocks, ok := message.Content.([]interface{}); ok {
				for _, block := range blocks {
					blockMap, _ := block.(map[string]interface{})
					var cb ClaudeContentBlock
					b, _ := json.Marshal(blockMap)
					json.Unmarshal(b, &cb)

					if cb.Type == "text" {
						contentBlocks = append(contentBlocks, OpenAIContentBlock{
							Type: "text",
							Text: cb.Text,
						})
					} else if cb.Type == "thinking" {
						thinking := ""
						if cb.Thinking != nil {
							thinking = *cb.Thinking
						} else if cb.Text != nil {
							thinking = *cb.Text
						}
						block := OpenAIContentBlock{
							Type:     "thinking",
							Thinking: &thinking,
						}
						if cb.Signature != nil {
							block.Signature = cb.Signature
						}
						contentBlocks = append(contentBlocks, block)
					} else if cb.Type == "tool_use" {
						args, _ := json.Marshal(cb.Input)
						toolCalls = append(toolCalls, OpenAIToolCall{
							ID:   *cb.ID,
							Type: "function",
							Function: struct {
								Name      string `json:"name"`
								Arguments string `json:"arguments"`
							}{
								Name:      *cb.Name,
								Arguments: string(args),
							},
						})
					}
				}
			}

			// Determine content format
			var content interface{}
			if len(contentBlocks) == 0 {
				content = ""
			} else if len(contentBlocks) == 1 && contentBlocks[0].Type == "text" {
				content = *contentBlocks[0].Text
			} else {
				content = contentBlocks
			}

			assistantMsg := OpenAIMessage{
				Role:    "assistant",
				Content: content,
			}
			if len(toolCalls) > 0 {
				assistantMsg.ToolCalls = toolCalls
			}
			openaiMessages = append(openaiMessages, assistantMsg)
		}
	}

	openaiRequest := OpenAIRequest{
		Model:       claudeRequest.Model,
		Messages:    openaiMessages,
		MaxTokens:   &claudeRequest.MaxTokens,
		Temperature: claudeRequest.Temperature,
		TopP:        claudeRequest.TopP,
		Stream:      claudeRequest.Stream,
		Stop:        claudeRequest.StopSequences,
	}

	// Pass through thinking parameter
	if claudeRequest.Thinking != nil {
		openaiRequest.Thinking = claudeRequest.Thinking
	}

	// Convert tools
	if len(claudeRequest.Tools) > 0 {
		var tools []OpenAITool
		for _, tool := range claudeRequest.Tools {
			cleanedParams := recursivelyCleanSchema(tool.InputSchema)
			tools = append(tools, OpenAITool{
				Type: "function",
				Function: struct {
					Name        string                 `json:"name"`
					Description string                 `json:"description,omitempty"`
					Parameters  map[string]interface{} `json:"parameters"`
				}{
					Name:        tool.Name,
					Description: tool.Description,
					Parameters:  cleanedParams.(map[string]interface{}),
				},
			})
		}
		openaiRequest.Tools = tools
	}

	// Convert tool choice
	if claudeRequest.ToolChoice != nil {
		if claudeRequest.ToolChoice.Type == "auto" || claudeRequest.ToolChoice.Type == "any" {
			openaiRequest.ToolChoice = "auto"
		} else if claudeRequest.ToolChoice.Type == "tool" {
			openaiRequest.ToolChoice = OpenAIToolChoice{
				Type: "function",
				Function: struct {
					Name string `json:"name"`
				}{
					Name: *claudeRequest.ToolChoice.Name,
				},
			}
		}
	}

	// Enable usage in streaming
	if claudeRequest.Stream != nil && *claudeRequest.Stream {
		openaiRequest.StreamOptions = &StreamOptions{IncludeUsage: true}
	}

	return openaiRequest
}

func convertOpenAIToClaudeResponse(openaiResponse map[string]interface{}, model string) map[string]interface{} {
	choices := openaiResponse["choices"].([]interface{})
	choice := choices[0].(map[string]interface{})
	message := choice["message"].(map[string]interface{})

	// Map OpenAI ID to Claude format
	messageID := mapOpenAIIDToClaude(openaiResponse["id"])
	originalID := openaiResponse["id"].(string)

	var contentBlocks []map[string]interface{}

	// Handle thinking blocks
	if thinkingBlocks, ok := message["thinking_blocks"].([]interface{}); ok {
		for _, tb := range thinkingBlocks {
			block := tb.(map[string]interface{})
			thinkingBlock := map[string]interface{}{
				"type":     "thinking",
				"thinking": block["thinking"],
			}
			if sig, ok := block["signature"]; ok {
				thinkingBlock["signature"] = sig
			}
			contentBlocks = append(contentBlocks, thinkingBlock)
		}
	} else if reasoningContent, ok := message["reasoning_content"].(string); ok {
		thinkingBlock := map[string]interface{}{
			"type":      "thinking",
			"thinking":  reasoningContent,
			"signature": extractIDSuffix(originalID),
		}
		contentBlocks = append(contentBlocks, thinkingBlock)
	}

	// Handle text content
	if content, ok := message["content"].(string); ok && content != "" {
		contentBlocks = append(contentBlocks, map[string]interface{}{
			"type": "text",
			"text": content,
		})
	}

	// Handle tool calls
	if toolCalls, ok := message["tool_calls"].([]interface{}); ok {
		for _, tc := range toolCalls {
			call := tc.(map[string]interface{})
			function := call["function"].(map[string]interface{})
			var input map[string]interface{}
			json.Unmarshal([]byte(function["arguments"].(string)), &input)

			contentBlocks = append(contentBlocks, map[string]interface{}{
				"type":  "tool_use",
				"id":    call["id"],
				"name":  function["name"],
				"input": input,
			})
		}
	}

	// Map finish reason
	stopReasonMap := map[string]string{
		"stop":       "end_turn",
		"length":     "max_tokens",
		"tool_calls": "tool_use",
	}
	finishReason := choice["finish_reason"].(string)
	stopReason := stopReasonMap[finishReason]
	if stopReason == "" {
		stopReason = "end_turn"
	}

	usage := openaiResponse["usage"].(map[string]interface{})
	log.Printf("messageId: %s", messageID)

	return map[string]interface{}{
		"id":          messageID,
		"type":        "message",
		"role":        "assistant",
		"model":       model,
		"content":     contentBlocks,
		"stop_reason": stopReason,
		"usage": map[string]interface{}{
			"input_tokens":  usage["prompt_tokens"],
			"output_tokens": usage["completion_tokens"],
		},
	}
}

func mapOpenAIIDToClaude(id interface{}) string {
	if id == nil {
		return fmt.Sprintf("msg_%s", randomString(9))
	}
	idStr, ok := id.(string)
	if !ok {
		return fmt.Sprintf("msg_%s", randomString(9))
	}
	re := regexp.MustCompile(`^[a-zA-Z]+-([A-Za-z0-9_\-]+)`)
	matches := re.FindStringSubmatch(idStr)
	if len(matches) > 1 {
		return "msg_" + matches[1]
	}
	return "msg_" + idStr
}

func extractIDSuffix(id string) string {
	re := regexp.MustCompile(`^[a-zA-Z]+-([A-Za-z0-9_\-]+)`)
	matches := re.FindStringSubmatch(id)
	if len(matches) > 1 {
		return matches[1]
	}
	return id
}

func randomString(n int) string {
	const letters = "abcdefghijklmnopqrstuvwxyz0123456789"
	b := make([]byte, n)
	for i := range b {
		b[i] = letters[i%len(letters)]
	}
	return string(b)
}

// --- Streaming Transformer ---

type streamTransformer struct {
	model              string
	initialized        bool
	messageID          string
	requestID          string
	toolCalls          map[int]*toolCallState
	thinkingBlocks     map[int]*thinkingBlockState
	contentBlockIndex  int
	textBlockStarted   bool
	textContent        string
	reasoningStarted   bool
	reasoningContent   string
	inputTokens        int
	outputTokens       int
	lastDelta          map[string]interface{}
}

type toolCallState struct {
	ID           string
	Name         string
	Args         string
	ClaudeIndex  int
	Started      bool
	Stopped      bool
}

type thinkingBlockState struct {
	Content     string
	ClaudeIndex int
	Started     bool
	Stopped     bool
	Signature   *string
}

func newStreamTransformer(model string) *streamTransformer {
	return &streamTransformer{
		model:             model,
		toolCalls:         make(map[int]*toolCallState),
		thinkingBlocks:    make(map[int]*thinkingBlockState),
		contentBlockIndex: -1,
	}
}

func (st *streamTransformer) transform(line string) []string {
	if !strings.HasPrefix(line, "data: ") {
		return nil
	}

	data := strings.TrimPrefix(line, "data: ")
	data = strings.TrimSpace(data)

	if data == "[DONE]" {
		return st.handleDone()
	}

	var chunk map[string]interface{}
	if err := json.Unmarshal([]byte(data), &chunk); err != nil {
		return nil
	}

	return st.processChunk(chunk)
}

func (st *streamTransformer) processChunk(chunk map[string]interface{}) []string {
	var events []string

	// Initialize message
	if !st.initialized {
		if id, ok := chunk["id"].(string); ok {
			st.requestID = id
			st.messageID = mapOpenAIIDToClaude(id)
		} else {
			st.messageID = fmt.Sprintf("msg_%s", randomString(9))
		}
		log.Printf("messageId: %s", st.messageID)
		events = append(events, st.sendEvent("message_start", map[string]interface{}{
			"type": "message_start",
			"message": map[string]interface{}{
				"id":          st.messageID,
				"type":        "message",
				"role":        "assistant",
				"model":       st.model,
				"content":     []interface{}{},
				"stop_reason": nil,
				"usage": map[string]interface{}{
					"input_tokens":  0,
					"output_tokens": 0,
				},
			},
		}))
		st.initialized = true
	}

	// Handle usage
	if usage, ok := chunk["usage"].(map[string]interface{}); ok {
		if pt, ok := usage["prompt_tokens"].(float64); ok {
			st.inputTokens = max(st.inputTokens, int(pt))
		}
		if ct, ok := usage["completion_tokens"].(float64); ok {
			st.outputTokens = max(st.outputTokens, int(ct))
		}
	}

	// Process delta
	choices, ok := chunk["choices"].([]interface{})
	if !ok || len(choices) == 0 {
		return events
	}

	choice := choices[0].(map[string]interface{})
	delta, ok := choice["delta"].(map[string]interface{})
	if !ok {
		return events
	}

	// Handle transitions between content types
	events = append(events, st.handleTransitions(delta)...)

	// Process thinking blocks
	if thinkingBlocks, ok := delta["thinking_blocks"].([]interface{}); ok {
		events = append(events, st.handleThinkingBlocks(thinkingBlocks)...)
	}

	// Process reasoning content
	if reasoningContent, ok := delta["reasoning_content"].(string); ok {
		events = append(events, st.handleReasoningContent(reasoningContent)...)
	}

	// Process text content
	if content, ok := delta["content"].(string); ok {
		events = append(events, st.handleTextContent(content)...)
	}

	// Process tool calls
	if toolCalls, ok := delta["tool_calls"].([]interface{}); ok {
		events = append(events, st.handleToolCalls(toolCalls)...)
	}

	st.lastDelta = delta
	return events
}

func (st *streamTransformer) handleTransitions(delta map[string]interface{}) []string {
	var events []string

	// Transition from thinking to text/tool_calls
	if st.lastDelta != nil {
		if _, hadThinking := st.lastDelta["thinking_blocks"]; hadThinking {
			if _, hasThinking := delta["thinking_blocks"]; !hasThinking {
				if _, hasContent := delta["content"]; hasContent {
					events = append(events, st.stopAllThinkingBlocks()...)
				}
				if _, hasToolCalls := delta["tool_calls"]; hasToolCalls {
					events = append(events, st.stopAllThinkingBlocks()...)
				}
			}
		}

		// Transition from text to tool calls
		if _, hadContent := st.lastDelta["content"]; hadContent {
			if _, hasToolCalls := delta["tool_calls"]; hasToolCalls {
				if _, hasContent := delta["content"]; !hasContent {
					events = append(events, st.stopTextBlock()...)
				}
			}
		}

		// Transition from reasoning_content to thinking_blocks
		if _, hadReasoning := st.lastDelta["reasoning_content"]; hadReasoning {
			if _, hasThinkingBlocks := delta["thinking_blocks"]; hasThinkingBlocks {
				if st.reasoningStarted {
					events = append(events, st.stopReasoningBlock()...)
				}
			}
		}

		// Transition away from reasoning_content
		if _, hadReasoning := st.lastDelta["reasoning_content"]; hadReasoning {
			if _, hasReasoning := delta["reasoning_content"]; !hasReasoning {
				if _, hasThinkingBlocks := delta["thinking_blocks"]; !hasThinkingBlocks {
					if st.reasoningStarted {
						events = append(events, st.stopReasoningBlock()...)
					}
				}
			}
		}
	}

	return events
}

func (st *streamTransformer) handleThinkingBlocks(blocks []interface{}) []string {
	var events []string
	for _, block := range blocks {
		tb := block.(map[string]interface{})
		thinkingIndex := 0

		if st.thinkingBlocks[thinkingIndex] == nil {
			st.thinkingBlocks[thinkingIndex] = &thinkingBlockState{}
		}

		state := st.thinkingBlocks[thinkingIndex]

		// Store signature
		if sig, ok := tb["signature"].(string); ok {
			state.Signature = &sig
		}

		// Start or update thinking block
		thinking, hasThinking := tb["thinking"].(string)
		if hasThinking || (tb["signature"] != nil && state.Started) {
			if !state.Started {
				if st.contentBlockIndex == -1 {
					st.contentBlockIndex = 0
				}
				state.ClaudeIndex = st.contentBlockIndex
				state.Started = true

				contentBlock := map[string]interface{}{
					"type":     "thinking",
					"thinking": "",
				}
				if state.Signature != nil {
					contentBlock["signature"] = *state.Signature
				}
				events = append(events, st.sendEvent("content_block_start", map[string]interface{}{
					"type":          "content_block_start",
					"index":         st.contentBlockIndex,
					"content_block": contentBlock,
				}))
			}

			if hasThinking {
				state.Content += thinking
				events = append(events, st.sendEvent("content_block_delta", map[string]interface{}{
					"type":  "content_block_delta",
					"index": state.ClaudeIndex,
					"delta": map[string]interface{}{
						"type":     "thinking_delta",
						"thinking": thinking,
					},
				}))
			}

			if sig, ok := tb["signature"].(string); ok && state.Started {
				events = append(events, st.sendEvent("content_block_delta", map[string]interface{}{
					"type":  "content_block_delta",
					"index": state.ClaudeIndex,
					"delta": map[string]interface{}{
						"type":      "signature_delta",
						"signature": sig,
					},
				}))
			}
		}
	}
	return events
}

func (st *streamTransformer) handleReasoningContent(content string) []string {
	var events []string

	if !st.reasoningStarted {
		if st.contentBlockIndex == -1 {
			st.contentBlockIndex = 0
		}
		st.reasoningStarted = true
		events = append(events, st.sendEvent("content_block_start", map[string]interface{}{
			"type":  "content_block_start",
			"index": st.contentBlockIndex,
			"content_block": map[string]interface{}{
				"type":     "thinking",
				"thinking": "",
			},
		}))
	}

	st.reasoningContent += content
	events = append(events, st.sendEvent("content_block_delta", map[string]interface{}{
		"type":  "content_block_delta",
		"index": st.contentBlockIndex,
		"delta": map[string]interface{}{
			"type":     "thinking_delta",
			"thinking": content,
		},
	}))

	return events
}

func (st *streamTransformer) handleTextContent(content string) []string {
	var events []string

	if !st.textBlockStarted {
		if st.contentBlockIndex == -1 {
			st.contentBlockIndex = 0
		}
		events = append(events, st.sendEvent("content_block_start", map[string]interface{}{
			"type":  "content_block_start",
			"index": st.contentBlockIndex,
			"content_block": map[string]interface{}{
				"type": "text",
				"text": "",
			},
		}))
		st.textBlockStarted = true
	}

	st.textContent += content
	events = append(events, st.sendEvent("content_block_delta", map[string]interface{}{
		"type":  "content_block_delta",
		"index": st.contentBlockIndex,
		"delta": map[string]interface{}{
			"type": "text_delta",
			"text": content,
		},
	}))

	return events
}

func (st *streamTransformer) handleToolCalls(toolCalls []interface{}) []string {
	var events []string

	for _, tc := range toolCalls {
		call := tc.(map[string]interface{})
		index := int(call["index"].(float64))

		if st.toolCalls[index] == nil {
			st.toolCalls[index] = &toolCallState{}
		}

		state := st.toolCalls[index]

		if id, ok := call["id"].(string); ok {
			state.ID = id
		}
		if function, ok := call["function"].(map[string]interface{}); ok {
			if name, ok := function["name"].(string); ok {
				state.Name = name
			}
			if args, ok := function["arguments"].(string); ok {
				state.Args += args
			}
		}

		if state.ID != "" && state.Name != "" && !state.Started {
			if st.contentBlockIndex == -1 {
				st.contentBlockIndex = 0
			}
			state.ClaudeIndex = st.contentBlockIndex
			state.Started = true
			events = append(events, st.sendEvent("content_block_start", map[string]interface{}{
				"type":  "content_block_start",
				"index": st.contentBlockIndex,
				"content_block": map[string]interface{}{
					"type":  "tool_use",
					"id":    state.ID,
					"name":  state.Name,
					"input": map[string]interface{}{},
				},
			}))
		}

		if state.Started {
			if function, ok := call["function"].(map[string]interface{}); ok {
				if args, ok := function["arguments"].(string); ok {
					events = append(events, st.sendEvent("content_block_delta", map[string]interface{}{
						"type":  "content_block_delta",
						"index": state.ClaudeIndex,
						"delta": map[string]interface{}{
							"type":         "input_json_delta",
							"partial_json": args,
						},
					}))
				}
			}
		}
	}

	return events
}

func (st *streamTransformer) handleDone() []string {
	var events []string

	// Stop reasoning block if active
	if st.reasoningStarted {
		events = append(events, st.stopReasoningBlock()...)
	}

	// Stop all active blocks
	events = append(events, st.stopAllThinkingBlocks()...)
	events = append(events, st.stopTextBlock()...)
	events = append(events, st.stopAllToolBlocks()...)

	// Determine stop reason
	stopReason := "end_turn"

	// Send final events
	events = append(events, st.sendEvent("message_delta", map[string]interface{}{
		"type": "message_delta",
		"delta": map[string]interface{}{
			"stop_reason":   stopReason,
			"stop_sequence": nil,
		},
		"usage": map[string]interface{}{
			"input_tokens":  st.inputTokens,
			"output_tokens": st.outputTokens,
		},
	}))

	events = append(events, st.sendEvent("message_stop", map[string]interface{}{
		"type": "message_stop",
	}))

	return events
}

func (st *streamTransformer) stopReasoningBlock() []string {
	var events []string
	if st.reasoningStarted {
		signature := extractIDSuffix(st.requestID)
		if signature == "" && st.messageID != "" {
			signature = extractIDSuffix(st.messageID)
		}
		events = append(events, st.sendEvent("content_block_delta", map[string]interface{}{
			"type":  "content_block_delta",
			"index": st.contentBlockIndex,
			"delta": map[string]interface{}{
				"type":      "signature_delta",
				"signature": signature,
			},
		}))
		events = append(events, st.sendEvent("content_block_stop", map[string]interface{}{
			"type":  "content_block_stop",
			"index": st.contentBlockIndex,
		}))
		st.reasoningStarted = false
		st.contentBlockIndex++
	}
	return events
}

func (st *streamTransformer) stopAllThinkingBlocks() []string {
	var events []string
	for _, state := range st.thinkingBlocks {
		if state.Started && !state.Stopped {
			events = append(events, st.sendEvent("content_block_stop", map[string]interface{}{
				"type":  "content_block_stop",
				"index": state.ClaudeIndex,
			}))
			state.Stopped = true
			st.contentBlockIndex++
		}
	}
	return events
}

func (st *streamTransformer) stopTextBlock() []string {
	var events []string
	if st.textBlockStarted {
		events = append(events, st.sendEvent("content_block_stop", map[string]interface{}{
			"type":  "content_block_stop",
			"index": st.contentBlockIndex,
		}))
		st.textBlockStarted = false
		st.contentBlockIndex++
	}
	return events
}

func (st *streamTransformer) stopAllToolBlocks() []string {
	var events []string
	for _, state := range st.toolCalls {
		if state.Started && !state.Stopped {
			events = append(events, st.sendEvent("content_block_stop", map[string]interface{}{
				"type":  "content_block_stop",
				"index": state.ClaudeIndex,
			}))
			state.Stopped = true
			st.contentBlockIndex++
		}
	}
	return events
}

func (st *streamTransformer) sendEvent(event string, data interface{}) string {
	dataBytes, _ := json.Marshal(data)
	return fmt.Sprintf("event: %s\ndata: %s\n\n", event, string(dataBytes))
}

func max(a, b int) int {
	if a > b {
		return a
	}
	return b
}